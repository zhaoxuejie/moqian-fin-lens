# 环境变量样例：复制为 .env 后填写真实值，禁止提交真实密钥
# 由 src/core/config.py 读取；必填项缺失时服务拒绝启动

# 运行环境：dev / staging / prod
APP_ENV=dev
LOG_LEVEL=info

# 数据目录与 SQLite 文件（必填）
DATA_DIR=./data
DATABASE_PATH=./data/app.db

# 上传与解析约束
MAX_UPLOAD_MB=50
MAX_PAGES=400
MAX_FILINGS_PER_SESSION=5

# 科目映射置信度阈值（低于该值进入「待确认」）
ALIGN_CONFIDENCE_THRESHOLD=0.85

# LLM 配置：v1.0 后续任务接入，未配置时自动降级为纯规则
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
